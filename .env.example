# Set these locally. Never put real credentials in source control.
WALLAHA_ADMIN_PHONE=01113887292
WALLAHA_ADMIN_USERNAME=owner
WALLAHA_ADMIN_PASSWORD=replace-with-a-long-private-password

# Email OTP and password recovery: authenticated SMTP over TLS.
WALLAHA_SMTP_HOST=
WALLAHA_SMTP_PORT=587
WALLAHA_SMTP_FROM=
WALLAHA_SMTP_USER=
WALLAHA_SMTP_PASSWORD=
# Optional AI support; set the secret in Railway, never in source.
OPENAI_API_KEY=
WALLAHA_AI_MODEL=gpt-4.1-mini
# Alternative email delivery over HTTPS using a verified Resend sender.
RESEND_API_KEY=
WALLAHA_EMAIL_FROM=
